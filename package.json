{
  "name": "agy-game-studio",
  "displayName": "Game Dev Studio",
  "version": "0.4.0",
  "description": "Antigravity game development skills for Phaser Web and Godot Mobile/PC, a shared asset MCP server, and a Phaser playtest panel.",
  "type": "module",
  "main": "sidecars/studio/main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harpuria/agy-game-studio.git"
  },
  "homepage": "https://github.com/harpuria/agy-game-studio#readme",
  "bugs": {
    "url": "https://github.com/harpuria/agy-game-studio/issues"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node sidecars/studio/main.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "antigravity",
    "plugin",
    "sidecar",
    "ui-extension",
    "game-dev-studio",
    "procedural-audio",
    "procedural-music",
    "procedural-sfx",
    "chiptune",
    "synth",
    "ym2612",
    "coreaudio",
    "audio",
    "gamedev",
    "gemini",
    "mcp",
    "lyria",
    "nano-banana",
    "aseprite",
    "2d-sprites",
    "phaser",
    "godot"
  ],
  "author": "Daniela Petruzalek <daniela@danicat.dev> (https://danicat.dev)",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
